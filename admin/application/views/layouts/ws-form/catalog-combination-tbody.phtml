<tr>
	<td><input id="allChecker" type="checkbox" onclick="checkAllCombs(this,<?=preg_replace('/^sazka\\[([0-9]+)\\]\\[kombinace_jine\\]/','\\1',$_REQUEST['opener'])?>);" /><?=$this->trans('select_all')?></td>
	<td colspan="9"></td>
</tr>
<?php foreach ($this->layout()->data as $bet) : ?>
