<?php if (in_array($bet['typeId'],$this->typesToShow)) : ?>
	<tr class="noBg">
		<?php $mainBets[] = $i  ?>
		<td style="width:60px">
				<input type="hidden" id="bet_show_<?=$i?>" value="1" />
				<input type="checkbox" class="checker" id="c<?=$i?>" name="c<?=$i?>" onclick="setBetsAndCombs(<?=$i?>,<?=preg_replace('/^sazka\\[([0-9]+)\\]\\[kombinace_jine\\]/','\\1',$_REQUEST['opener'])?>);" />
				<button onclick="
					javascript:window.opener.document.getElementById('<?=$this->opener?>').value+='<?=$bet['betId']?>;';
