<form method="post" action="?superb=1&section=<?=$sectionId?>">
	<table class="table-detail float-left payout-sum">
		<tr>
			<th colspan="2">Celkově</th>
		</tr>
		<tr>
			<td>Celkem tiketů ke zpracování:</td>
			<td class="border-left"><?=count($tickets)?></td>
		</tr>
		<tr>
			<td>Zrušených tiketů:</td>
			<td class="border-left"><?=$cancelTicketCount?></td>
		</tr>
		<tr>
			<td>Výherních tiketů: </td>
			<td class="border-left"><?=$lossTicketCount?></td>
