function confirmTicket(data,act) {
	if (act == 1) {
		if (tick.confirming) return false;
		tick.confirming = true;
		tick.betsLocked = true;
		tick.clearNotifications();
		var parm = {couponId:tick.couponId,coupon:data};
		$.post('<?=$this->UrlSet(11)?>',parm,function(retdata) {
			if (retdata.search(/^\s*json:/) >= 0) {
				var data = JSON.parse(retdata.substr(5));
				if (undefined !== data.commands)
					tick.executeCommands(data.commands);
				$('#ticket_data_sender').attr('value', tick.words['okf8']);
			} else if(retdata != 1) {
				$('#ticket_container2').html(retdata)
				$('#ticket_container2').show();
				$('#ticket_data_sender').attr('value', tick.words['okf8']);
			} else {
				$('#ticket_data_sender').show();
				for (var x=2; x<10; x++)
					$('#ghtr'+x).hide();
				$('#ghtr1').html(Ticket.bit1);
				$('#ghtr3').show().html(Ticket.bproveText);
			}
			tick.confirming = false;
			$('#ticket_content :input').removeProp('disabled');
			//tick.scrollToNotification();
		}, "html");
	}
}

function confirmTicket2(confirm, start) {
	if (tick.confirming)
		return false;
	tick.confirming = true;
	tick.betsLocked = true;
	var buttonVisible = ('hidden' != $('#buttonConfirm2').css('visibility'));
	$('#buttonConfirm2').attr('value',tick.words['okf10']);
	if (!buttonVisible)
		$('#buttonConfirm2').css('visibility', 'visible');

	if (undefined === confirm)
		confirm = true;
	if (undefined === start)
		start = (0 == tick.confirmationRuns);
	++tick.confirmationRuns;

	var url = (tick.preapproved ? '<?=$this->UrlSet(59)?>' : '<?=$this->UrlSet(12)?>');
	var data = (start ? tick.getCouponData(true) : false);

	$.post(url,
		{confirm: (confirm ? 1 : 0), start: (start ? 1 : 0), couponId: tick.couponId, coupon: data},
		function(retdata) {
			if (!buttonVisible)
				$('#buttonConfirm2').css('visibility', 'hidden');
			$('#buttonConfirm2').attr('value', tick.words['okf8']);
			if (retdata.search(/^\s*json:/) >= 0) {
				retdata = retdata.replace(/^\s*json:/, '');
				var data = JSON.parse(retdata);
				if (undefined !== data.commands)
					tick.executeCommands(data.commands);
			}
			else if (retdata != 1) {
				$('#ticket_container').hide();
				$('#box_kupon').addClass('box-kupon-no-tabs');
				$('#ticket_container2').html(retdata);
				$('#ticket_container2').show();
				$('#ticket_data_sender').attr('value', tick.words['okf8']);
			}
			else {
				for(var x=2;x<10;x++)
					$('#ghtr'+x).hide();

				$('#ghtr1').html(Ticket.bit1);
				$('#ghtr3').show().html('<div class="notify notify-info">'+Ticket.bproveText+'</div>');
			}
			tick.confirming = false;
			//tick.scrollToNotification();
		},
		"html"
	);
}

function parseCombinationStakes() {
	if (tick.betsLocked)
		return false;
	var result = true;
	if (tick.isMaxicombinator()) {
		if (false === tick.combinations) {
			tick.totalBet = 0;
		}
		else {
			tick.totalBet = 0;
			for (var i = 0; i < tick.combinations.length; ++i) {
				var k = i + 1;
				var stake = tick.updatedAmount('mcStake'+k, $('#mcStake' + k).val(), tick.combinations[i].stake);
				if (false === stake) {
					tick.alternateCss($('#mcStake' + k), 'background-color', 'red', 6, 300);
					result = false;
					continue;
				}
				if (stake != tick.combinations[i].stake)
					tick.givenTotalBet = false;
				//$('#mcStake' + k).val(tick.formatCurrency(stake));
				var enabled = (0 < stake);
				tick.enableCombination(i, enabled);
				$('#mcUsed' + k).attr('checked', (enabled ? 'checked' : '') );
				tick.combinations[i].stake = stake;
				if (tick.combinations[i].used)
					tick.totalBet += stake * tick.combinations[i].betCount;
			}
		}
		tick.SetTotalSum();
	}
	return result;
}

function parseTotalBet() {
	if (tick.betsLocked) return false;
	var result = true;
	if (tick.isMaxicombinator()) {
		var total = tick.updatedAmount('total_bet', $('#total_bet').val(), tick.totalBet);
		if (false === total || total == tick.totalBet) {
			tick.givenTotalBet = false;
			result = false;
		} else {
			tick.givenTotalBet = total;
			tick.totalBet = total;
			//tick.updateCombinationStakes();
			updateMaxicombinator();
		}
	}
	return result;
}

function enableCombination(i, enabled) {
	if (tick.betsLocked)
		return false;
	if (tick.isMaxicombinator()) {
		tick.enableCombination(i, enabled);
		updateMaxicombinator();
	}
}

function updateMaxicombinator() {
	if (tick.givenTotalBet)
		tick.updateCombinationStakes();
	else
		tick.totalBet = updateCombinationStakes();
	tick.SetTotalSum();
}

function updateCombinationStakes() {
	var total = 0;
	for (var i = 0; i < tick.combinations.length; ++i) {
		var comb = tick.combinations[i];
		if (comb.used)
			total += comb.stake * comb.betCount;
		$('#mcStake' + (i + 1)).val(tick.formatCurrency(comb.stake));
	}
	return total;
}
