function createTicket() {
	tick.initializing = true;
	<?php if (isset($this->createTicket['bet'])): ?>
		<?php foreach($this->createTicket['bet'] as $data): ?>
			tick.ChangeBet(<?= $data['id_bet'] .','. $data['id_col'] .',"'
			. (empty($data['mtext'])?'':$this->escapeJs($data['mtext'], true, true)) .'","'
			. $this->escapeJs((empty($data['tnazev'])?'':$data['tnazev'] . (empty($data['textNote']) ? '' : " {$data['textNote']}")), true, true) . '","'
			. (!isset($data['pnazev'])?'':$data['pnazev']) .'",'
			. $data['rate'] .','
			. (empty($data['simple'])?0:$data['simple']) . ', 0, null, '
			. $data['amount'] .','
			. (empty($data['live'])?0:$data['live']) .','
			. $data['group'] . ", '"
			. (empty($data['couponTime'])?'':$data['couponTime']) . "'" ?>);
		<?php endforeach; ?>
		<?php if ($this->createTicket['type'] != 'simple'): ?>
			tick.totalBet=<?=!empty($this->createTicket['totalSum']) ? floatval($this->createTicket['totalSum']) : 0; ?>;
		<?php endif; ?>
		<?php if ($this->createTicket['type'] == 'kombi'): ?>
			tick.pointType=<?=empty($this->createTicket['pointType']) ? 'null' : $this->createTicket['pointType']; ?>;
			tick.rateAdvance=<?=empty($this->createTicket['rateAdvance']) ? 'null' : $this->createTicket['rateAdvance']; ?>;
		<?php endif; ?>
		<?php if ($this->createTicket['type'] == 'maxikombi'): ?>
			tick.updateGroupCounts();
			tick.updateCombinations( 0, false, new Array(<?php for ($i = 1, $n = count($this->createTicket['combinations']); $i < $n; ++$i) {
				$data = $this->createTicket['combinations'][$i];
				echo (1 < $i ? ',' : '') . '{stake:' . (empty($data['stake']) ? 0 : floatval($data['stake'])) . ',used:' . (!isset($data['used']) || false !== $data['used'] ? 'true' : 'false') . '}' ; } ?>) );
		<?php endif; ?>
		tick.rateAdvanceCost = 0;
	<?php endif; ?>
	tick.page = tick.page_help = <?= It6_Models_Ticket::TYPE_SIMPLE == $this->createTicket['helper']->type ? 0 : 1 ?>;

	tick.initializing = false;
	if (1 == tick.confirmationStep)
		confirmTicket(tick.getCouponData(true), 1);
	else if (1 < tick.confirmationStep)
		tick.confirmationStart(undefined, true);
	else {
		tick.blockSysDel = true;
		tick.UpdateAll(undefined, 1);
		tick.blockSysDel = false;
	}
}

