          <?php endif; ?>
        <form method="post" action="" id="loginForm">
			<table class="table form-table">
				<tr>
					<td class="col-xs-4"><label for="nick"><?= $this->trans('reg_email') ?>:</label></td>
					<td><input type="text" id="nick" name="nick" placeholder="<?= $this->trans('reg_email') ?>" /></td>
				</tr>
				<tr>
					<td class="col-xs-4"><label for="pass"><?= $this->trans('reg_pass') ?>:</label></td>
