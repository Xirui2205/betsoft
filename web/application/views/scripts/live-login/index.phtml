<div class="m0a w50p">
	<img src="/new/images/logo.png" alt="logo" />
	<h2 class="boxheader"><?= $this->trans('live-login') ?></h2>	
	<div class="contentbox">
		
		<?php if ($this->trans('live-login-text') !== 'live-login-text') { ?>
			<p><?= $this->trans('live-login-text'); ?></p>
		<?php } ?>
		<?php if (true === $this->authenticated): ?>
          <p>
            <a href="<?= $this->redirectUrl ?>"><?= $this->redirectUrl ?></a>
