				</tr>
				<tr>
					<td colspan="2" class="text-center">
						<input type="submit" value="<?= $this->trans('login') ?>" id="login" class="btn btn-biggest" />
						<br><a class="" href="<?=$this->UrlSet(25); ?>">
							<?=$this->trans('forget_pass');?>
						</a>
