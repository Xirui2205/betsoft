									echo 'block';
									else
									echo 'none';
									?>">
									<a class="f-<?= $this->OblastIP; ?>" 
										href="<?= $this->UrlSet(2, '', '', $sData['oblast'][$this->OblastIP]['url']); ?>" >
										<?= $sData['oblast'][$this->OblastIP]['text']; ?>
										<span class="count"><?= $sData['oblast'][$this->OblastIP]['pocet'] ?></span>
