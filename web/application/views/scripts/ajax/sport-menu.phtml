					<?php if (1 == $sData['open']): ?>
						<ul id="sport_menu_<?= $sid ?>">
							<!-- OBLAST IP -->
							<?php
							$areas = 0;
							$maxAreas = $this->maxAreas;
							if ($xSport == 0 && $this->OblastIP && isset($sData['oblast'][$this->OblastIP])):
								?>
