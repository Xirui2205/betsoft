<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:complexType name="tResource">
    <xs:sequence>
      <xs:element name="key" type="xs:string" />
      <xs:element name="langId" type="xs:positiveInteger" />
      <xs:element name="text" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tTranslations">
    <xs:sequence>
      <xs:element name="resource" type="tResource" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tAssociation">
    <xs:sequence>
      <xs:element name="key" type="xs:string" />
      <xs:element name="controller" type="xs:string" />
      <xs:element name="action" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tAssociations">
    <xs:sequence>
      <xs:element name="resource" type="tAssociation" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tMissingResource">
    <xs:sequence>
      <xs:element name="key" type="xs:string" />
      <xs:element name="langId" type="xs:positiveInteger" />
      <xs:element name="controller" type="xs:string" />
      <xs:element name="action" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tMissing">
    <xs:sequence>
      <xs:element name="resource" type="tMissingResource" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="tData">
    <xs:sequence>
      <xs:element name="translations" type="tTranslations" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="associations" type="tAssociations" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="missing" type="tMissing" minOccurs="0" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>
  
  <xs:element name="data" type="tData" />

</xs:schema>
